---
import { STRAPI_URL } from "../lib/urlConfig";
import type Article from "../interfaces/article";
import { Image } from "astro:assets";
import Picture from "astro/components/Picture.astro";

const { article } = Astro.props;

// Make sure these URLs are constructed properly
const articleImageSrc = `${STRAPI_URL}${article.image.url}`;
const authorImageSrc = `${STRAPI_URL}${article.author.image.url}`;
---

<a href={`/blog/${article.slug}/`} class="block group no-underline">
  <article
    class="flex flex-col h-full bg-white border border-gray-200 rounded-lg shadow-md transform transition-all duration-300 ease-in-out group-hover:shadow-xl group-hover:-translate-y-1 group-hover:border-orange-200"
  >
    <div class="overflow-hidden rounded-t-lg">
      <!-- <Image
        src={articleImageSrc}
        alt={article.title}
        width={600}
        height={400}
        class="w-full h-48 object-cover transform transition-transform duration-300 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      /> -->

      <Picture
        width={600}
        height={400}
        decoding="async"
        class="w-full h-48 object-cover transform transition-transform duration-300 group-hover:scale-105"
        src={articleImageSrc}
        formats={["avif", "webp"]}
        alt={article.title}
      />
    </div>

    <div
      class="mt-5 justify-between px-4 pb-1 flex items-center gap-x-4 text-xs text-gray-500"
    >
      <time datetime={article.createdAt}>
        {new Date(article.createdAt).toLocaleDateString()}
      </time>
      <div class="flex gap-2 flex-wrap">
        {
          /* {
          article.tags.map((tag) => (
            <span
              key={tag.id}
              class="px-2 py-0.5 bg-orange-400 text-amber-50 rounded-full text-xs font-semibold transform transition-transform duration-300 group-hover:scale-105"
            >
              {tag.name}
            </span>
          ))
        } */
        }
      </div>
    </div>

    <div class="relative mt-4 px-4 flex-grow">
      <h3
        class="text-xl font-semibold text-gray-900 transition-colors duration-300 group-hover:text-orange-500"
      >
        {article.title}
      </h3>
      <p class="mt-3 text-sm text-gray-600 line-clamp-3">
        {article.description}
      </p>
    </div>

    <div class="mt-6 flex items-center gap-x-4 px-4 pb-4">
      <div class="overflow-hidden rounded-full">
        <Image
          src={authorImageSrc}
          alt={article.author.name}
          width={40}
          height={40}
          class="w-10 h-10 object-cover transform transition-transform duration-300 group-hover:scale-110"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="text-sm">
        <p
          class="font-semibold text-gray-900 transition-colors duration-300 group-hover:text-orange-500"
        >
          {article.author.name}
        </p>
        <p class="text-gray-500">{article.author.role || "Author"}</p>
      </div>
    </div>
  </article>
</a>
